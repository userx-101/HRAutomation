    {
      "parameters": {
        "jsCode": "const sub = $('Validate Submission').first();\nconst email = sub.json.email.toLowerCase();\nconst position = sub.json.position;\nconst rows = $input.all().map(i => i.json);\nconst alreadyApplied = rows.some(r =>\n  String(r['Email'] || '').toLowerCase() === email && r['Position'] === position);\n\n// Sheets read drops the file, so carry the CV binary forward from the validated submission\nreturn [{ json: { ...sub.json, alreadyApplied }, binary: sub.binary }];"
      },
