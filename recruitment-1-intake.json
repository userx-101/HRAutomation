    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst d = item.json;\nconst errors = [];\nconst name = (d.Name || '').trim();\nconst email = (d.Email || '').trim();\n\nif (name.length < 2) errors.push('Name is required');\nif (!/^\\S+@\\S+\\.\\S+$/.test(email)) errors.push('A valid email is required');\n\n// The form stores the upload under a generated key, so find the first binary and rename it to \"cv\"\nconst binKey = Object.keys(item.binary || {})[0];\nif (!binKey) {\n  errors.push('A CV file is required');\n} else if (!String(item.binary[binKey].mimeType || '').includes('pdf')) {\n  errors.push('CV must be a PDF');\n}\n\nconst out = {\n  json: {\n    valid: errors.length === 0,\n    errors: errors.join('; '),\n    name, email,\n    position: d.Position,\n    appliedAt: $now.toFormat('yyyy-MM-dd HH:mm')\n  }\n};\nif (binKey) out.binary = { cv: item.binary[binKey] };\nreturn [out];"
      },
      "id": "3d175d42-3de7-4b74-a5c6-573967655b4f",
