    {
      "parameters": {
        "jsCode": "// Give stock back for expired lines that had already taken stock (confirmed / approved).\n// Pending lines never took stock, so they are skipped.\nconst now = Date.now();\nconst took = ['confirmed', 'approved'];\nconst rows = $('Read Reservations').all().map(i => i.json);\nconst catalog = $input.all().map(i => i.json);\n\nconst back = {};\nfor (const r of rows) {\n  if (!r.res_id || !took.includes(String(r.status).toLowerCase())) continue;\n  if (!r.expires_at || !(Date.parse(r.expires_at) < now)) continue;\n  back[r.sku] = (back[r.sku] || 0) + (Number(r.qty) || 0);\n}\nreturn Object.entries(back).flatMap(([sku, qty]) => {\n  const c = catalog.find(x => String(x.sku) === String(sku));\n  if (!c) return [];\n  return [{ json: { sku, stock: (Number(c.stock) || 0) + qty } }];\n});"
      },
      "name": "Restock Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
