    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst low = items\n  .filter(c => c.sku && Number(c.stock) <= Number(c.reorder_level))\n  .map(c => ({\n    sku: c.sku, name: c.name, strength: c.strength,\n    stock: Number(c.stock), reorder_level: Number(c.reorder_level),\n    controlled: String(c.controlled).toLowerCase() === 'yes'\n  }));\nif (!low.length) return [];\n\nconst text = low.map(c =>\n  '• ' + c.name + ' ' + c.strength + ' (' + c.sku + '): ' + c.stock + ' left, reorder at ' + c.reorder_level +\n  (c.stock === 0 ? ' — OUT OF STOCK' : '') + (c.controlled ? ' — controlled' : '')\n).join('\\n');\nconst html = '<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>SKU</th><th>Medicine</th><th>Stock</th><th>Reorder level</th></tr>' +\n  low.map(c => '<tr><td>' + c.sku + '</td><td>' + c.name + ' ' + c.strength + (c.controlled ? ' (controlled)' : '') + '</td><td>' + c.stock + '</td><td>' + c.reorder_level + '</td></tr>').join('') + '</table>';\nreturn [{ json: { count: low.length, text, html, lines: low } }];"
      },
