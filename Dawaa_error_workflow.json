      "parameters": {
        "jsCode": "// Reservations whose hold time has passed and are still open\nconst now = Date.now();\nconst open = ['pending', 'confirmed', 'approved'];\nconst rows = $('Read Reservations').all().map(i => i.json);\nreturn rows\n  .filter(r => r.res_id && open.includes(String(r.status).toLowerCase()) && r.expires_at && Date.parse(r.expires_at) < now)\n  .map(r => ({ json: {\n    row_number: r.row_number,\n    res_id: r.res_id,\n    customer_id: r.customer_id,\n    wa_phone_id: r.wa_phone_id,\n    name: r.name,\n    qty: r.qty,\n    status: 'expired'\n  }}));"
