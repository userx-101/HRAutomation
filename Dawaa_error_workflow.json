      "parameters": {
        "jsCode": "const e = $json.execution?.error || {};\nconst msg = String(e.message || 'Unknown error');\nconst low = (msg + ' ' + (e.name || '') + ' ' + (e.description || '')).toLowerCase();\nconst node = $json.execution?.lastNodeExecuted || e.node?.name || 'Unknown node';\n\nlet type = 'Other';\nlet critical = false;\nif (/credential|unauthori[sz]ed|forbidden|401|403|invalid.*token|permission|auth/.test(low)) { type = 'Auth / Credentials'; critical = true; }\nelse if (/429|rate.?limit|quota|too many requests/.test(low)) { type = 'Rate limit / Quota'; }\nelse if (/timeout|timed out|econnrefused|econnreset|enotfound|socket|network|502|503|504/.test(low)) { type = 'Network / Timeout'; }\nelse if (/google|sheet|spreadsheet|range|column|row|catalog|reservation/.test(low) || /sheet/.test(node.toLowerCase())) { type = 'Google Sheets / Data'; critical = true; }\nelse if (/whatsapp|telegram|gmail|message/.test(low)) { type = 'Messaging'; }\nelse if (/json|parse|undefined|cannot read|is not defined|syntax/.test(low)) { type = 'Code / Data format'; }\nif (/trigger/.test(node.toLowerCase())) critical = true;\n\nreturn [{ json: {\n  time: new Date().toISOString(),\n  workflow: $json.workflow?.name || 'Unknown workflow',\n  node,\n  type,\n  message: msg.slice(0, 500),\n  execution_url: $json.execution?.url || '',\n  is_critical: critical\n}}];"
      },
