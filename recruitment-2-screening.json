      "id": "3cefcecc-5535-4cde-a646-ba59df5d12a2",
      "name": "Extract Candidate Profile",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        2240,
        368
      ],
      "onError": "continueErrorOutput"
